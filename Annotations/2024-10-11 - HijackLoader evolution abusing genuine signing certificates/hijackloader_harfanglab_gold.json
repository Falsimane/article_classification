    {
      "type": "campaign",
      "spec_version": "2.1",
      "created": "2024-10-11T00:00:00.000Z",
      "modified": "2026-10-27T00:00:00.000Z",
      "id": "campaign--4a60f117-7b72-595e-9a14-911be5f75c82",
      "name": "Campagne fake CAPTCHA (HijackLoader / Lumma Stealer)",
      "description": "Faux CAPTCHA incitant à coller une charge PowerShell, téléchargement d'une archive ZIP puis exécution de HijackLoader (par DLL sideloading, ou binaire signé), qui déploie Lumma Stealer. Depuis mi-septembre 2024.",
      "labels": [
        "gold:required"
      ],
      "x_gold_evidence_quote": "The so-called “fake CAPTCHA” campaign has already been extensively documented",
      "x_gold_sequence": [
        {
          "order": 1,
          "summary": "Page de faux CAPTCHA : le bouton « I’m not a robot » invite à saisir des raccourcis clavier qui ouvrent une ligne de commande où coller la charge PowerShell copiée dans le presse-papiers.",
          "techniques": [
            "T1204.004"
          ]
        },
        {
          "order": 2,
          "summary": "Exécution de la charge PowerShell, selon trois variantes : mshta, iex (PowerShell brut) ou msiexec.",
          "techniques": [
            "T1059.001",
            "T1218.005",
            "T1218.007"
          ]
        },
        {
          "order": 3,
          "summary": "Téléchargement d'une archive ZIP, décompression, exécution d'un binaire.",
          "techniques": [
            "T1105"
          ]
        },
        {
          "order": 4,
          "summary": "Paquet de DLL sideloading : la DLL malveillante déchiffre et exécute le fichier chiffré qui dissimule l'étape finale de HijackLoader.",
          "techniques": [
            "T1574.001",
            "T1027.013"
          ]
        },
        {
          "order": 5,
          "summary": "HijackLoader télécharge et exécute Lumma Stealer.",
          "techniques": [
            "T1105"
          ]
        },
        {
          "order": null,
          "summary": "Variante observée le 2 octobre 2024 : exécutable HijackLoader signé avec un certificat de signature de code authentique, hors paquet de DLL sideloading.",
          "techniques": [
            "T1553.002"
          ]
        }
      ]
    },
