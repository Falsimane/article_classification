    {
      "type": "malware",
      "spec_version": "2.1",
      "id": "malware--0e28117f-2e73-5d80-9c13-df20735b0e71",
      "created": "2023-01-10T00:00:00.000Z",
      "modified": "2026-10-27T00:00:00.000Z",
      "name": "Pilote noyau malveillant (désactivation de csagent.sys)",
      "is_family": false,
      "description": "Pilote noyau Windows 64 bits (moins de 35 fonctions) chargé via un pilote Intel vulnérable ; déchiffre par XOR une liste de produits de sécurité ciblés, trouve csagent.sys (composant noyau CrowdStrike Falcon) et le patche en mémoire à des offsets codés en dur ; les routines installées signalent un succès au capteur sans rien faire.",
      "labels": [
        "gold:required"
      ],
      "x_gold_evidence_quote": "deploy a malicious kernel driver through a vulnerability (CVE-2015-2291)",
      "x_gold_context": "Pilote 64 bits non nommé par l'article, signé par divers certificats ; il recherche csagent.sys et patche en mémoire ses routines avec du code trampoline."
    },
