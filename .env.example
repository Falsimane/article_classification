# Local Ollama configuration
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3.8:27b
# Délai maximal d'un appel d'extraction (55 s reste sous la limite d'une minute)
CTI_LLM_TIMEOUT=55
# Contexte de chaque requête, le même pour tous les clients (sinon Ollama recharge le modèle) ; sur le serveur, lancer
# `ollama serve` avec OLLAMA_CONTEXT_LENGTH à la même valeur pour que `ollama run` ne provoque pas de rechargement
OLLAMA_NUM_CTX=12288
# Requêtes simultanées : la valeur de OLLAMA_NUM_PARALLEL du serveur (un client n'en envoie jamais davantage)
OLLAMA_NUM_PARALLEL=2
