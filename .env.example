# Données (hors git) : défaut backend/data (sources/, bundles/, eval/, raw/, archive/)
# CTI_DATA_DIR=/chemin/vers/data

# Classification (cti-classifier) : serveur Ollama
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3.8:27b
# Contexte de chaque requête ; sur le serveur, lancer `ollama serve` avec OLLAMA_CONTEXT_LENGTH à la même valeur
OLLAMA_NUM_CTX=12288

# Extraction (cti-extract) : serveur vLLM / SGLang (API /v1/chat/completions), lancé avec un analyseur d'appels d'outils
CTI_OPENAI_URL=http://127.0.0.1:8010/v1
CTI_OPENAI_MODEL=cti-qwen
# Requêtes en vol (le --max-running-requests du serveur) et délai maximal d'un appel, en secondes
CTI_LLM_SLOTS=10
CTI_LLM_TIMEOUT=180
